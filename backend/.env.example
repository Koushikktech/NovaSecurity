# NovaSecurity Backend Environment Configuration

# Amazon Nova / LLM Configuration
# Set your Amazon Nova or compatible OpenAI API key
NOVA_API_KEY=your_nova_api_key_here
NOVA_BASE_URL=https://api.nova.amazon.com/v1
NOVA_MODEL=nova-2-lite-v1

# FastAPI CORS Settings (comma-separated origins)
NOVA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# GitHub Integration (Optional - for pushing automated PR fixes)
GITHUB_TOKEN=your_github_token_here

# Supabase Persistence (Optional - for storing scan history)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
