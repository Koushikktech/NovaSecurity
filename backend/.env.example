# Proofline Backend Environment Configuration
# Neural Storm 2026 — Track FT-05 (AI-Powered Automated Code Review)

# Google Gemini API Configuration (server only; never NEXT_PUBLIC_*)
GEMINI_API_KEY=
PROOFLINE_GEMINI_REVIEW_MODEL=
PROOFLINE_GEMINI_PATCH_MODEL=
PROOFLINE_GEMINI_REASONING_MODEL=

# Concurrency & Operational Limits
PROOFLINE_LLM_MAX_CONCURRENCY=2
PROOFLINE_LLM_REQUEST_TIMEOUT_SECONDS=45
PROOFLINE_REVIEW_DEADLINE_SECONDS=180
PROOFLINE_LLM_MAX_ATTEMPTS=3
PROOFLINE_MAX_MODEL_CALLS_PER_RUN=12
PROOFLINE_MAX_OUTPUT_TOKENS=4096
PROOFLINE_MAX_CONTEXT_TOKENS=24000

# Persistence & Storage
PROOFLINE_DATABASE_URL=sqlite:///./data/proofline.db
PROOFLINE_ARTIFACT_DIR=./data/artifacts
PROOFLINE_WORKSPACE_DIR=./data/workspaces

# Network & Server Security
PROOFLINE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
PROOFLINE_EXECUTION_ENABLED=true
PROOFLINE_GITHUB_PUBLISH_ENABLED=false
GITHUB_TOKEN=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# For remote operator deployment; never expose as a public demo key.
PROOFLINE_OPERATOR_TOKEN=
# Isolated verification requires a prebuilt digest-pinned image.
PROOFLINE_VERIFICATION_IMAGE=

# Optional proactive pacing; 0 learns cooldowns from provider quota errors.
PROOFLINE_MODEL_REQUESTS_PER_MINUTE=0

# auto: Interactions for modern models; generate_content for Gemini 2.5.
PROOFLINE_GEMINI_API_MODE=auto

# Optional LOCALHOST Codex provider: uses native ChatGPT CLI login, not API keys.
PROOFLINE_LLM_PROVIDER=gemini
PROOFLINE_CODEX_CLI_ENABLED=false
PROOFLINE_CODEX_CLI_PATH=codex
PROOFLINE_CODEX_MODEL=auto
PROOFLINE_CODEX_REASONING=high
PROOFLINE_CODEX_REQUEST_TIMEOUT_SECONDS=120
