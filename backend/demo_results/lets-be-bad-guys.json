      "vulnerability_type": "Remote Code Execution via exec()",
      "severity": "Critical",
      "file": "badguys/vulnerable/views.py",
      "line": 72,
      "description": "User-supplied input from request.POST['first_name'] is base64-decoded and passed directly to exec() without any sanitization. An attacker can encode arbitrary Python code in base64 and submit it as the first_name field to achieve full remote code execution on the server.",
      "confidence": 0.95,
      "final_confidence": 0.925,
      "validation_status": "Confirmed",
      "red_team_poc": "import base64; payload = base64.b64encode(b\"import os; os.system('id > p0wned.txt')\"); requests.post('/vulnerable/code-execution/', data={'first_name': payload})",
      "red_team_success": true,
      "red_team_attack_vector": "POST request with base64-encoded Python payload in first_name form field",
      "blue_team_disputed": false,
      "blue_team_defense": "No defensive mechanisms present. The exec() call has no sandboxing, input validation, or restricted execution environment.",
      "corroborated": true,
      "sources": ["targeted_scan", "indexed_sweep"],
