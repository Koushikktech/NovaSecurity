      "vulnerability_type": "SQL Injection (Authentication Bypass)",
      "severity": "Critical",
      "file": "bad/libuser.py",
      "line": 12,
      "description": "The login function constructs a SQL query using Python string formatting (.format()) with user-supplied username and password, allowing classic SQL injection. An attacker can bypass authentication entirely with a payload like ' OR '1'='1' -- in the username field, gaining access to any account without knowing the password.",
      "confidence": 0.97,
      "final_confidence": 0.95,
      "validation_status": "Confirmed",
      "red_team_poc": "username: ' OR '1'='1' --\npassword: anything\n\nResulting SQL: SELECT * FROM users WHERE username = '' OR '1'='1' --' and password = 'anything'\n\nThis returns the first user in the database (usually admin), bypassing authentication completely.",
      "red_team_success": true,
      "red_team_attack_vector": "Login form submission with SQL injection payload in username field to bypass authentication",
      "blue_team_disputed": false,
      "blue_team_defense": "No parameterized queries, no input sanitization, no prepared statements. The .format() string interpolation directly concatenates user input into SQL.",
      "corroborated": true,
      "sources": ["targeted_scan", "indexed_sweep"],
      "path": ["request.form::bad/mod_user.py:16", "libuser.login::bad/libuser.py:5", "c.execute::bad/libuser.py:12"],
