      "category": "bug",
      "rule_id": "proofline:python/mutable-default-argument",
      "cwe_id": null,
      "title": "Mutable default argument retains state across function invocations",
      "explanation": "The default argument `items=[]` is evaluated once when the function is defined rather than upon each invocation. Because `items.append(item)` mutates this list in place, subsequent invocations relying on the default parameter share and accumulate values across calls.",
      "user_impact": "Callers invoking `collect(item)` without passing `items` will receive a list containing items from previous invocations, causing state leakage and incorrect results.",
      "severity": "high",
      "primary_location": {
        "path": "src/module.py",
        "start_line": 1,
        "end_line": 1,
        "side": "head",
