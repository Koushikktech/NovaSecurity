          "rule_id": "proofline:mutable-default-argument",
          "cwe_id": "CWE-675",
          "title": "Mutable default argument persists state across function calls",
          "explanation": "The `collect` function uses a mutable default argument (`items=[]`). In Python, default parameter expressions are evaluated once when the function definition is executed, meaning the exact same list instance is reused for every call to `collect` where `items` is not provided.",
          "user_impact": "Subsequent calls to `collect(item)` without passing `items` will retain and return accumulated values from prior invocations rather than creating a new list for each call.",
          "severity": "high",
